# Optional: docker compose up works without a .env file, using the defaults below.
# Copy to .env to change them. Never commit .env.

# PostgreSQL
DB_NAME=fairexit
DB_USER=fairexit
DB_PASSWORD=change-me

# MinIO (local S3 compatible storage for the Evidence Vault). The password needs 8+ characters.
MINIO_ROOT_USER=fairexit
MINIO_ROOT_PASSWORD=change-me-too

# JWT signing key, at least 32 characters. Make one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-32-plus-chars

# Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run without AI: bills are then typed in by hand.
GEMINI_API_KEY=
# Any Gemini model that supports generateContent with JSON output
GEMINI_MODEL=gemini-3.8-flash

# Browser origins allowed to call the API on port 8080 directly (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Accounts that may import price data (comma separated)
ADMIN_EMAILS=

# Per user requests per minute. Keep 60; raise (for example to 1000000) only for the k6 load test.
RATE_LIMIT_CAPACITY=60

# Grafana admin password (http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=admin
